# Copy to .env (never commit .env). Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Rate limits on /api/check (0 turns one off). The global limits cap total Gemini
# spend no matter how many visitors there are, so set them to what you can afford.
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=50
# GLOBAL_LIMIT_PER_MINUTE=30
# GLOBAL_LIMIT_PER_DAY=500

# Proxies whose X-Forwarded-For is believed (comma separated). Default: the Next.js
# server on the same machine. Add your load balancer's address if there is one.
# TRUSTED_PROXIES=127.0.0.1,::1

# Set to 1 to serve /docs and /openapi.json (local development only).
# ENABLE_API_DOCS=1

# Largest upload in MB. Vercel and Netlify reject request bodies over ~4.5 MB, so keep
# 4 there. Set the same value as NEXT_PUBLIC_MAX_UPLOAD_MB in the web app.
# MAX_UPLOAD_MB=4
